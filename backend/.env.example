# HTTP server
PORT=8787
# Frontend origin allowed by CORS (comma-separated for multiple)
ALLOWED_ORIGIN=http://localhost:5173
# Optional shared secret the frontend must send as `x-access-token` (leave empty = open in dev)
ACCESS_TOKEN=

# TMDB (used server-side to bridge a TMDB id -> title/year for MovieBox search)
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_API_KEY=your_tmdb_v4_read_access_token

# Key used to HMAC-sign relay URLs so the stream proxy only serves URLs it minted
RELAY_SIGN_KEY=change-me-to-a-long-random-string

# Runtime MovieBox signing key (60 hex characters). Required for Phase 2 verification.
# No built-in key is included; supply an authorized key locally and never commit it.
MOVIEBOX_SECRET_HEX=
