# HTTP server
PORT=8787
# Default is loopback only. Exact unscoped IP literal; ::1 also supported.
# Set 0.0.0.0 explicitly only when LAN/container reachability is intended.
HOST=127.0.0.1
# Frontend origin allowed by CORS (comma-separated for multiple)
ALLOWED_ORIGIN=http://localhost:5173
# Optional shared secret the frontend must send as `x-access-token` (leave empty = open in dev)
ACCESS_TOKEN=

# TMDB (used server-side to bridge a TMDB id -> title/year for MovieBox search)
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_API_KEY=your_tmdb_v4_read_access_token

# Optional stable relay signing key: exactly 64 hex characters (32 bytes).
# Empty generates a cryptographically random memory-only key per backend process.
# Restart already invalidates memory-local playback sessions and media capabilities.
RELAY_SIGN_KEY=
# Exact operator-approved HTTPS CDN hostnames (comma-separated, no wildcards).
# Leave empty until independently verified; reference hosts are not live proof.
MOVIEBOX_MEDIA_HOSTS=
# Separate subtitle hosts; CDN cookies are never forwarded to caption hosts.
MOVIEBOX_CAPTION_HOSTS=

# Runtime MovieBox signing key (60 hex characters). Required for Phase 2 verification.
# No built-in key is included; supply an authorized key locally and never commit it.
MOVIEBOX_SECRET_HEX=
